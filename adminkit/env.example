APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
# Pakai `s3` bila unggahan disimpan di object storage (lihat blok AWS di bawah).
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── SMTP (surel keluar: email sambutan, dsb.) ──
# MAIL_SCHEME wajib `smtp` (bukan `tls`) — Symfony Mailer tidak mengenal skema `tls`.
# Port 587 = STARTTLS, port 465 = SSL (pakai MAIL_SCHEME=smtps).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Object Storage S3-compatible (avatar, aset merek, modul Object Storage) ──
# Contoh nilai memakai Neo NOS; sesuaikan region/endpoint dengan penyedia Anda.
# AWS_PATH = prefix folder di dalam bucket. AWS_URL diisi hanya bila memakai CDN/custom domain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=idn
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=https://nos.wjv-1.neo.id
AWS_URL=
AWS_PATH=adminkit

TELESCOPE_ENABLED=true
TELESCOPE_ALLOWED_EMAILS=

VITE_APP_NAME="${APP_NAME}"
